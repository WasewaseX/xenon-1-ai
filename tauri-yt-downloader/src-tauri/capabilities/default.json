{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window: core IPC, native dialogs, filesystem access and shell spawn scopes for yt-dlp/ffmpeg helper processes.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "yt-dlp", "cmd": "yt-dlp", "args": true },
        { "name": "ffmpeg", "cmd": "ffmpeg", "args": true },
        { "name": "ffprobe", "cmd": "ffprobe", "args": true }
      ]
    }
  ]
}
